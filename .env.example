# --- Firebase ---
# 未設定でもアプリはゲストモード（メモリ内 state）で動作します。
# 値を入れると Google ログイン＆Firestore 同期が有効になります。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Gemini API（Phase 2: 持ち物のAI推論）---
# 未設定なら gemini.ts は自動でルールベース（items.ts）にフォールバックします。
VITE_GEMINI_API_KEY=
